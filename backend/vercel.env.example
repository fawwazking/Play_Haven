# Vercel -> playhaven-backend project -> Settings -> Environment Variables.
# Add each line as a separate key (Production + Preview). Never commit real values.

SECRET_KEY=<django secret: python -c "import secrets;print(secrets.token_urlsafe(50))">
DEBUG=False
ALLOWED_HOSTS=playhaven-backend.vercel.app,.vercel.app

# Supabase pooler (IPv4). Port 6543 = transaction pooler. Keep DB_CONN_MAX_AGE=0 on serverless.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DB_CONN_MAX_AGE=0

# Midtrans Sandbox (must be the key pair of the same project)
MIDTRANS_SERVER_KEY=<SB-Mid-server-...>
MIDTRANS_CLIENT_KEY=<SB-Mid-client-...>
MIDTRANS_IS_PRODUCTION=False

# RajaOngkir Starter
RAJAONGKIR_API_KEY=<key>
RAJAONGKIR_ORIGIN_SUBDISTRICT=575

# CORS: the deployed Next.js origin(s), comma separated
CORS_ALLOWED_ORIGINS=https://playhaven-store.vercel.app
